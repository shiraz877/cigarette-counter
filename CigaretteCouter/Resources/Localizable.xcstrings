    "See how much you spend on cigarettes every day, week, and month." : {
      "comment" : "A description below the main content of the view.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شاهد كم تنفق على السجائر كل يوم وأسبوع وشهر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রতিদিন, সপ্তাহ এবং মাসে আপনি সিগারেটে কত খরচ করেন তা দেখুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh, wie viel du täglich, wöchentlich und monatlich für Zigaretten ausgibst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See how much you spend on cigarettes every day, week, and month."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira cuánto gastas en cigarrillos cada día, semana y mes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Découvrez combien vous dépensez en cigarettes chaque jour, semaine et mois."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "देखें कि आप हर दिन, सप्ताह और महीने सिगरेट पर कितना खर्च करते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lihat berapa banyak pengeluaran Anda untuk rokok setiap hari, minggu, dan bulan."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಪ್ರತಿ ದಿನ, ವಾರ ಮತ್ತು ತಿಂಗಳಿಗೆ ನೀವು ಸಿಗರೇಟ್‌ಗಳಿಗೆ ಎಷ್ಟು ಖರ್ಚು ಮಾಡುತ್ತೀರಿ ಎಂಬುದನ್ನು ನೋಡಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "എല്ലാ ദിവസവും ആഴ്ചയിലും മാസത്തിലും സിഗരറ്റിനായി നിങ്ങൾ എത്ര ചെലവഴിക്കുന്നു എന്ന് കാണുക."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja quanto você gasta com cigarros todos os dias, semanas e meses."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смотрите, сколько вы тратите на сигареты каждый день, неделю и месяц."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஒவ்வொரு நாள், வாரம் மற்றும் மாதத்திலும் சிகரெட்டுக்கு நீங்கள் எவ்வளவு செலவழிக்கிறீர்கள் என்பதைக் காணுங்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ప్రతిరోజు, వారానికి మరియు నెలకు మీరు సిగరెట్ల కోసం ఎంత ఖర్చు చేస్తారో చూడండి."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigaraya her gün, hafta ve ay ne kadar harcadığınızı görün."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دیکھیں کہ آپ ہر دن، ہفتے اور مہینے سگریٹ پر کتنا خرچ کرتے ہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看您每天、每周和每月在香烟上花费多少钱。"
          }
        }
      }
    },
    "See when you smoke the most, how often you smoke, and how your habits change over time." : {
      "comment" : "A description of the benefits of tracking smoking habits.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعرف على أوقات ذروة التدخين لديك، ومعدل تكراره، وكيف تتغير عاداتك بمرور الوقت."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি কখন সবচেয়ে বেশি ধূমপান করেন, কত ঘন ঘন করেন এবং সময়ের সাথে আপনার অভ্যাস কীভাবে পরিবর্তিত হয় তা দেখুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh, wann du am meisten rauchst, wie oft du rauchst und wie sich deine Gewohnheiten im Laufe der Zeit verändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See when you smoke the most, how often you smoke, and how your habits change over time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira cuándo fumas más, con qué frecuencia fumas y cómo cambian tus hábitos con el tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Découvrez quand vous fumez le plus, à quelle fréquence, et comment vos habitudes évoluent au fil du temps."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "देखें कि आप कब सबसे अधिक धूम्रपान करते हैं, कितनी बार करते हैं, और समय के साथ आपकी आदतें कैसे बदलती हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lihat kapan Anda paling banyak merokok, seberapa sering Anda merokok, dan bagaimana kebiasaan Anda berubah seiring waktu."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನೀವು ಯಾವಾಗ ಹೆಚ್ಚು ಧೂಮಪಾನ ಮಾಡುತ್ತೀರಿ, ಎಷ್ಟು ಬಾರಿ ಧೂಮಪಾನ ಮಾಡುತ್ತೀರಿ ಮತ್ತು ಕಾಲಾನಂತರ ನಿಮ್ಮ ಅಭ್ಯಾಸಗಳು ಹೇಗೆ ಬದಲಾಗುತ್ತವೆ ಎಂಬುದನ್ನು ನೋಡಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങൾ ഏറ്റവും കൂടുതൽ എപ്പോൾ പുകവലിക്കുന്നു, എത്ര തവണ പുകവലിക്കുന്നു, കാലക്രമേണ നിങ്ങളുടെ ശീലങ്ങൾ എങ്ങനെ മാറുന്നു എന്നിവ കാണുക."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja quando você mais fuma, com que frequência fuma e como seus hábitos mudam ao longo do tempo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смотрите, когда вы курите больше всего, как часто и как ваши привычки меняются со временем."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நீங்கள் அதிகம் புகைபிடிக்கும் நேரம், எவ்வளவு அடிக்கடி புகைபிடிக்கிறீர்கள், மற்றும் காலப்போக்கில் உங்கள் பழக்கங்கள் எப்படி மாறுகின்றன என்பதைக் காணுங்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీరు ఎప్పుడు ఎక్కువగా ధూమపానం చేస్తారు, ఎంత తరచుగా చేస్తారు, మరియు కాలక్రమేణా మీ అలవాట్లు ఎలా మారతాయో చూడండి."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En çok ne zaman sigara içtiğinizi, ne sıklıkla içtiğinizi ve alışkanlıklarınızın zamanla nasıl değiştiğini görün."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دیکھیں کہ آپ کب سب سے زیادہ تمباکو نوشی کرتے ہیں، کتنی بار کرتے ہیں، اور وقت کے ساتھ آپ کی عادتیں کیسے بدلتی ہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看您何时吸烟最多、吸烟频率如何，以及您的习惯如何随时间变化。"
          }
        }
      }
    },
