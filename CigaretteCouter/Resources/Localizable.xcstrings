    "Save your cigarette history and sync it across devices." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احفظ سجل السجائر الخاص بك وقم بمزامنتها عبر الأجهزة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার সিগারেটের ইতিহাস সংরক্ষণ করুন এবং এটি সব ডিভাইসে সিঙ্ক করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichere deinen Zigarettenverlauf und synchronisiere ihn geräteübergreifend."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save your cigarette history and sync it across devices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda tu historial de cigarrillos y sincronízalo entre dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez votre historique de cigarettes et synchronisez-le entre vos appareils."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपनी सिगरेट की हिस्ट्री सुरक्षित रखें और इसे सभी डिवाइस पर सिंक करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpan riwayat rokok Anda dan sinkronkan di semua perangkat."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿಮ್ಮ ಸಿಗರೇಟ್ ಇತಿಹಾಸವನ್ನು ಉಳಿಸಿ ಮತ್ತು ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ಸಿಂಕ್ ಮಾಡಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങളുടെ സിഗരറ്റ് ചരിത്രം സേവ് ചെയ്ത് എല്ലാ ഉപകരണങ്ങളിലും സമന്വയിപ്പിക്കുക."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salve seu histórico de cigarros e sincronize entre dispositivos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраняйте историю курения и синхронизируйте её между устройствами."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் சிகரெட் வரலாற்றைச் சேமித்து, சாதனங்களில் ஒத்திசைக்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ సిగరెట్ చరిత్రను సేవ్ చేసి, పరికరాల్లో సింక్ చేయండి."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigara geçmişinizi kaydedin ve cihazlar arasında senkronize edin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپنی سگریٹ کی ہسٹری محفوظ کریں اور اسے تمام آلات پر سنک کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存您的吸烟记录，并在设备间同步。"
