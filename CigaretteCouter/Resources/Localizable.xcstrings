    "Start with your first cigarette and let the numbers tell the story." : {
      "comment" : "A description of the feature that allows users to start tracking their cigarette use.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابدأ بسيجارتك الأولى وادع الأرقام تروي القصة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার প্রথম সিগারেট দিয়ে শুরু করুন এবং সংখ্যাগুলিকে গল্প বলতে দিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beginne mit deiner ersten Zigarette und lass die Zahlen die Geschichte erzählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start with your first cigarette and let the numbers tell the story."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza con tu primer cigarrillo y deja que los números cuenten la historia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commencez par votre première cigarette et laissez les chiffres raconter l'histoire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपनी पहली सिगरेट से शुरुआत करें और आंकड़ों को कहानी बयां करने दें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mulai dengan rokok pertama Anda dan biarkan angka-angka bercerita."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿಮ್ಮ ಮೊದಲ ಸಿಗರೇಟ್‌ನಿಂದ ಪ್ರಾರಂಭಿಸಿ ಮತ್ತು ಸಂಖ್ಯೆಗಳು ಕಥೆ ಹೇಳಲಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങളുടെ ആദ്യ സിഗരറ്റിൽ നിന്ന് ആരംഭിക്കുക, കണക്കുകൾ കഥ പറയട്ടെ."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comece com seu primeiro cigarro e deixe os números contarem a história."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начните с первой сигареты, и пусть цифры расскажут вашу историю."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் முதல் சிகரெட்டிலிருந்து தொடங்கி, எண்கள் கதையைச் சொல்லட்டும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ మొదటి సిగరెట్‌తో ప్రారంభించి, సంఖ్యలు కథను చెప్పనివ్వండి."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlk sigaranızla başlayın ve rakamlar hikayeyi anlatsın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپنی پہلی سگریٹ سے شروعات کریں اور اعداد و شمار کو کہانی بیان کرنے دیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从您的第一支烟开始，让数字讲述故事。"
          }
        }
      }
    },
