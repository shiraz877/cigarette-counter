    "By continuing, you agree to our Terms of Service and Privacy Policy." : {
      "comment" : "A text displayed below the account buttons, explaining the terms of service and privacy policy.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بالمتابعة، فإنك توافق على شروط الخدمة وسياسة الخصوصية الخاصة بنا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "চালিয়ে যাওয়ার মাধ্যমে, আপনি আমাদের পরিষেবার শর্তাবলী এবং গোপনীয়তা নীতিতে সম্মত হচ্ছেন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du fortfährst, stimmst du unseren Nutzungsbedingungen und der Datenschutzrichtlinie zu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By continuing, you agree to our Terms of Service and Privacy Policy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al continuar, aceptas nuestros Términos de servicio y Política de privacidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En continuant, vous acceptez nos conditions d'utilisation et notre politique de confidentialité."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आगे बढ़कर, आप हमारी सेवा की शर्तों और गोपनीयता नीति से सहमत होते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengan melanjutkan, Anda menyetujui Ketentuan Layanan dan Kebijakan Privasi kami."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಮುಂದುವರಿಸುವ ಮೂಲಕ, ನೀವು ನಮ್ಮ ಸೇವಾ ನಿಯಮಗಳು ಮತ್ತು ಗೌಪ್ಯತಾ ನೀತಿಗೆ ಒಪ್ಪುತ್ತೀರಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "തുടരുന്നതിലൂടെ, ഞങ്ങളുടെ സേവന നിബന്ധനകളും സ്വകാര്യതാ നയവും നിങ്ങൾ അംഗീകരിക്കുന്നു."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao continuar, você concorda com nossos Termos de Serviço e Política de Privacidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Продолжая, вы соглашаетесь с нашими Условиями обслуживания и Политикой конфиденциальности."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "தொடர்வதன் மூலம், எங்கள் சேவை விதிமுறைகள் மற்றும் தனியுரிமைக் கொள்கையை நீங்கள் ஏற்கிறீர்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "కొనసాగించడం ద్వారా, మీరు మా సేవా నిబంధనలు మరియు గోప్యతా విధానానికి అంగీకరిస్తున్నారు."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devam ederek Hizmet Şartlarımızı ve Gizlilik Politikamızı kabul etmiş olursunuz."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جاری رکھ کر، آپ ہماری سروس کی شرائط اور پرائیویسی پالیسی سے اتفاق کرتے ہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "继续即表示您同意我们的服务条款和隐私政策。"
          }
        }
      }
    },
    "By creating an account, you agree to our Privacy Policy. Your data belongs to you." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بإنشاء حساب، فإنك توافق على سياسة الخصوصية الخاصة بنا. بياناتك ملك لك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একটি অ্যাকাউন্ট তৈরি করার মাধ্যমে, আপনি আমাদের গোপনীয়তা নীতিতে সম্মত হচ্ছেন। আপনার ডেটা আপনারই থাকে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit der Erstellung eines Kontos stimmst du unserer Datenschutzrichtlinie zu. Deine Daten gehören dir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By creating an account, you agree to our Privacy Policy. Your data belongs to you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al crear una cuenta, aceptas nuestra Política de privacidad. Tus datos te pertenecen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En créant un compte, vous acceptez notre politique de confidentialité. Vos données vous appartiennent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अकाउंट बनाकर, आप हमारी गोपनीयता नीति से सहमत होते हैं। आपका डेटा आपका अपना है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengan membuat akun, Anda menyetujui Kebijakan Privasi kami. Data Anda adalah milik Anda."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಖಾತೆಯನ್ನು ರಚಿಸುವ ಮೂಲಕ, ನೀವು ನಮ್ಮ ಗೌಪ್ಯತಾ ನೀತಿಗೆ ಒಪ್ಪುತ್ತೀರಿ. ನಿಮ್ಮ ಡೇಟಾ ನಿಮ್ಮದೇ ಆಗಿದೆ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "അക്കൗണ്ട് സൃഷ്ടിക്കുന്നതിലൂടെ, ഞങ്ങളുടെ സ്വകാര്യതാ നയം നിങ്ങൾ അംഗീകരിക്കുന്നു. നിങ്ങളുടെ ഡാറ്റ നിങ്ങൾക്ക് സ്വന്തം."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao criar uma conta, você concorda com nossa Política de Privacidade. Seus dados pertencem a você."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создавая аккаунт, вы соглашаетесь с нашей Политикой конфиденциальности. Ваши данные принадлежат вам."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "கணக்கை உருவாக்குவதன் மூலம், எங்கள் தனியுரிமைக் கொள்கையை நீங்கள் ஏற்கிறீர்கள். உங்கள் தரவு உங்களுக்கே சொந்தமானது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఖాతాను సృష్టించడం ద్వారా, మీరు మా గోప్యతా విధానానికి అంగీకరిస్తున్నారు. మీ డేటా మీదే."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir hesap oluşturarak Gizlilik Politikamızı kabul etmiş olursunuz. Verileriniz size aittir."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اکاؤنٹ بنا کر، آپ ہماری پرائیویسی پالیسی سے اتفاق کرتے ہیں۔ آپ کا ڈیٹا آپ کا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "创建账户即表示您同意我们的隐私政策。您的数据归您所有。"
          }
        }
      }
    },
