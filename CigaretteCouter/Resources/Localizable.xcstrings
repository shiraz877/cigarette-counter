    "A simple way to track every cigarette and nunderstand your smoking habits." : {
      "comment" : "A paragraph explaining the purpose of the app.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "طريقة بسيطة لتتبع كل سيجارة وفهم عادات التدخين لديك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রতিটি সিগারেট ট্র্যাক করে আপনার ধূমপানের অভ্যাস বোঝার একটি সহজ উপায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine einfache Möglichkeit, jede Zigarette zu erfassen und deine Rauchgewohnheiten zu verstehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A simple way to track every cigarette and understand your smoking habits."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una forma sencilla de registrar cada cigarrillo y entender tus hábitos de fumar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un moyen simple de suivre chaque cigarette et de comprendre vos habitudes de tabagisme."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर सिगरेट को ट्रैक करने और अपनी धूम्रपान की आदतों को समझने का एक सरल तरीका।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cara sederhana untuk melacak setiap rokok dan memahami kebiasaan merokok Anda."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಪ್ರತಿ ಸಿಗರೇಟ್ ಅನ್ನು ಟ್ರ್ಯಾಕ್ ಮಾಡಲು ಮತ್ತು ನಿಮ್ಮ ಧೂಮಪಾನ ಅಭ್ಯಾಸಗಳನ್ನು ಅರ್ಥಮಾಡಿಕೊಳ್ಳಲು ಸರಳ ಮಾರ್ಗ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഓരോ സിഗരറ്റും ട്രാക്ക് ചെയ്ത് നിങ്ങളുടെ പുകവലി ശീലങ്ങൾ മനസ്സിലാക്കാനുള്ള ഒരു ലളിതമായ മാർഗം."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma forma simples de acompanhar cada cigarro e entender seus hábitos de fumar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Простой способ отслеживать каждую сигарету и понимать свои привычки курения."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஒவ்வொரு சிகரெட்டையும் கண்காணித்து உங்கள் புகைபிடிக்கும் பழக்கங்களைப் புரிந்துகொள்ள ஒரு எளிய வழி."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ప్రతి సిగరెట్‌ని ట్రాక్ చేసి మీ ధూమపాన అలవాట్లను అర్థం చేసుకోవడానికి ఒక సులభమైన మార్గం."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her sigarayı takip etmenin ve sigara alışkanlıklarınızı anlamanın basit bir yolu."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہر سگریٹ کو ٹریک کرنے اور اپنی تمباکو نوشی کی عادت کو سمجھنے کا ایک آسان طریقہ۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一种简单的方法，记录每一支烟，了解你的吸烟习惯。"
          }
        }
      }
    },
