    "Sync your cigarette history and settings across your devices." : {
      "comment" : "A description of how users can sync their cigarette history and settings across their devices.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بمزامنة سجل السجائر والإعدادات عبر أجهزتك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার সিগারেটের ইতিহাস এবং সেটিংস আপনার ডিভাইসে সিঙ্ক করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisiere deinen Zigarettenverlauf und deine Einstellungen geräteübergreifend."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync your cigarette history and settings across your devices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincroniza tu historial de cigarrillos y configuración entre tus dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisez votre historique de cigarettes et vos réglages entre vos appareils."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपनी सिगरेट की हिस्ट्री और सेटिंग्स को अपने सभी डिवाइस पर सिंक करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinkronkan riwayat rokok dan pengaturan Anda di semua perangkat."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿಮ್ಮ ಸಿಗರೇಟ್ ಇತಿಹಾಸ ಮತ್ತು ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ನಿಮ್ಮ ಸಾಧನಗಳಲ್ಲಿ ಸಿಂಕ್ ಮಾಡಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങളുടെ സിഗരറ്റ് ചരിത്രവും ക്രമീകരണങ്ങളും നിങ്ങളുടെ ഉപകരണങ്ങളിൽ സമന്വയിപ്പിക്കുക."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronize seu histórico de cigarros e configurações entre seus dispositivos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронизируйте историю курения и настройки на всех устройствах."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் சிகரெட் வரலாறு மற்றும் அமைப்புகளை உங்கள் சாதனங்களில் ஒத்திசைக்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
